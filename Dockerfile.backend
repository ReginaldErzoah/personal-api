FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock README.md ./

# 5. Copy the application source code
COPY src/ ./src/

# 6. Install project dependencies without development tools
RUN uv sync --no-dev --locked

# 7. Make the API port available
EXPOSE 8000

# 8. Start the FastAPI application
CMD ["uv", "run", "fastapi", "run", "src/personal_api/main.py", "--host", "0.0.0.0", "--port", "8000"]
